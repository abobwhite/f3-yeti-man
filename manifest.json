{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "F3 Yeti Man"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Yeti Man",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/yeti",
        "description": "Open Yeti Man commands",
        "should_escape": false,
        "url": "https://example.com/slack/events"
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": ["https://example.com/slack/oauth_redirect"],
    "scopes": {
      "bot": ["commands", "chat:write", "channels:history", "channels:read", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://example.com/slack/events",
      "bot_events": ["app_home_opened", "message.channels", "app_uninstalled", "tokens_revoked"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://example.com/slack/events"
    },
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
